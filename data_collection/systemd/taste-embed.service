[Unit]
Description=ResearchMate catalog: SPECTER2 embeddings
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/taste-collect.env
ExecStart=@UV@ run python -m collect embed
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
