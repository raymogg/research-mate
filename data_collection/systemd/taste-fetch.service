[Unit]
Description=taste-reader catalog: arXiv metadata harvest
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/taste-collect.env
ExecStart=@UV@ run python -m collect fetch
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
